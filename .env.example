# Nightscout instance URL
NIGHTSCOUT_URL=https://your-nightscout.herokuapp.com

# Auth: use EITHER api-secret OR token (not both)
# API secret — must be the SHA1 hash of your plaintext secret
# Generate with: echo -n "your-secret" | shasum -a 1 | awk '{print $1}'
NIGHTSCOUT_API_SECRET=
# Or readable token from Nightscout admin
NIGHTSCOUT_TOKEN=

# Request timeout in seconds
NIGHTSCOUT_TIMEOUT=30

# MCP server auth (Bearer token for Claude Code CLI)
MCP_AUTH_TOKEN=your-secret-token-here
